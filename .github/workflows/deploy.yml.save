name: Deploy Rata Audaz Final
on:
  push:
    branches: [ main ]

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v3

      - name: Crear config.js
        run: |
          echo "const CONFIG = {" > config.js
          echo "  WEATHER_API_KEY: '${{ secrets.WEATHER_API_KEY }}'," >> config.js
          echo "  CITY: '${{ secrets.CITY }}'," >> config.js
          echo "  UNITS: 'metric'," >> config.js
          echo "  LANG: 'es'" >> config.js
          echo "};" >> config.js  

      - name: Deploy a GitHub Pages
        uses: JamesIves/github-pages-deploy-action@v4
        with:
          folder: .        # Sube todo lo que hay en la carpeta raíz
          branch: gh-pages # A la rama gh-pa
          clean: false     # ¡IMPORTANTE! No borres lo que el robot creó antes
    - name: Rellenar config.js con los Secrets
        run: |
          sed -i "s/REPLACE_ME_API/${{ secrets.WEATHER_API_KEY }}/g" config.js
          sed -i "s/REPLACE_ME_CITY/${{ secrets.CITY }}/g" config.js
